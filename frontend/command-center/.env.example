# Frontend env — copy values as needed. Never commit real secrets.
# API host the browser calls directly (auth token mint + apiFetch).
NEXT_PUBLIC_API_BASE=http://localhost:4000
# API host used by Next.js rewrites (/api/* → API) and the WS hook default.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
