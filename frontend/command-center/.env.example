# Frontend env — copy values as needed. Never commit real secrets.
# ONE canonical API base (browser fetches + WS + Next.js rewrites all derive from it):
#   - apiFetch() / getAuthToken() → http(s) calls
#   - buildWsUrl() → ws(s):// conversion (http→ws, https→wss)
#   - next.config.js rewrites (/api/* → API)
NEXT_PUBLIC_API_BASE=http://localhost:4000
